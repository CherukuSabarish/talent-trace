{
  "manifest_version": 3,
  "name": "TalentTrace 2.0",
  "short_name": "TalentTrace 2.0",
  "version": "2.0.0",
  "description": "Send to Google Sheet: collects LinkedIn, Stack Overflow and GitHub profiles from Google X-ray result pages and sends them to your Talent Trace Google Sheet.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TalentTrace 2.0",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.in/search*",
        "https://www.google.co.uk/search*",
        "https://www.google.com.sg/search*",
        "https://www.google.ae/search*"
      ],
      "js": ["google.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://akamai-talent-trace.vercel.app/*",
        "https://*.vercel.app/*"
      ],
      "js": ["app-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
